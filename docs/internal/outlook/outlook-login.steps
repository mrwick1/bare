timeout 45000
open https://outlook.office.com/mail/
expect css="input[name=loginfmt]" visible
fill css="input[name=loginfmt]" "arjun@qilinlab.com"
click css="#idSIButton9"
timeout 20000
expect css="input[name=passwd]" visible
fill css="input[name=passwd]" "${PW}"
click css="#idSIButton9"
timeout 30000
expect css="#idSIButton9" visible
click css="#idSIButton9"
timeout 90000
expect css="[role=main]" visible
shot outlook-authed
