# The fixture app (app.html): the session of the brief user ends after one data request. The next request gets a 401, and the app
# removes the token and goes to the login page with a notice.
open ${BASE}/
type css="input[name=email]" "${EMAIL}"
type css="input[name=password]" "${PASSWORD}"
click css="form button[type=submit]"
click role=link name="Agents"
expect css="#list a" count 4
expect js "sessionStorage.getItem('token') !== null"
type css="input[type=search]" "${QUERY}\n"
expect url~"/login"
expect role=status text="Your session expired. Sign in again."
expect js "sessionStorage.length === 0"
expect css="input[name=password]" visible
