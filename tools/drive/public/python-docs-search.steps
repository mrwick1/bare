# docs.python.org: type in the search box of the top bar and press Enter; search.html opens with the query in its url.
#   bare-drive --var URL=https://docs.python.org/3/ python-docs-search.steps
timeout 30000
open ${URL}
expect css="div.related:nth-of-type(2) input[name=q]" count 1
type css="div.related:nth-of-type(2) input[name=q]" "asyncio\n"
expect url~"search.html?q=asyncio"
expect css="h1" text~"Search"
