# httpbin.org: fill the pizza order form (text, tel, email, radio, checkboxes, time, textarea); the form data holds the values.
#   bare-drive --var URL=https://httpbin.org/forms/post httpbin-form-fill.steps
timeout 30000
open ${URL}
expect css="form" visible
type label="Customer name:" "Ada Lovelace"
type label="Telephone:" "5551234"
type label="E-mail address:" "ada@example.com"
click label="Large"
click label="Bacon"
click label="Onion"
expect label="Large" checked
expect label="Bacon" checked
expect label="Extra Cheese" unchecked
type label="Delivery instructions:" "Ring twice"
expect label="Delivery instructions:" value="Ring twice"
expect js "(() => { const d = new URLSearchParams(new FormData(document.forms[0])); return d.get('custname') === 'Ada Lovelace' && d.get('custtel') === '5551234' && d.get('custemail') === 'ada@example.com' && d.get('size') === 'large' && d.getAll('topping').join() === 'bacon,onion' && d.get('comments') === 'Ring twice'; })()"
