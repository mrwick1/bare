# text: only text, title and count checks after one click
open ${BASE}/home state="${STATE}"
expect css="h1" text="Heading home"
click role=link name="Page 4"
expect css="h1" text="Heading p4"
expect title="p4"
expect css="#count" text="20"
expect css="tr" count 60
expect css="nav a" count 10
expect css="p" text~"Items"
